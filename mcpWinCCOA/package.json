{
  "name": "@etm-professional-control/winccoa-mcp-server",
  "version": "1.5.0",
  "description": "MCP Server for WinCC OA with field-specific configurations",
  "type": "module",
  "bin": {
    "winccoa-mcp-stdio": "./build/index_stdio.js",
    "winccoa-mcp-http": "./build/index_http.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "sbom": "cyclonedx-npm --omit dev --omit peer --output-format JSON --output-file sbom.json",
    "postinstall": "node postinstall.cjs",
    "inspect": "npx @modelcontextprotocol/inspector",
    "start": "node build/index_stdio.js",
    "start:http": "node build/index_http.js",
    "dev": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "build",
    "src/fields",
    "src/systemprompt.md",
    "config",
    "postinstall.cjs",
    ".env.example",
    "sbom.json",
    "README.md",
    "OSS.md",
    "LEGAL_INFO.md",
    "LICENSE.md"
  ],
  "keywords": [
    "mcp",
    "winccoa",
    "scada",
    "automation",
    "siemens",
    "industrial"
  ],
  "author": "ETM Control GesmbH",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winccoa/winccoa-ae-js-mcpserver.git"
  },
  "homepage": "https://github.com/winccoa/winccoa-ae-js-mcpserver#readme",
  "bugs": {
    "url": "https://github.com/winccoa/winccoa-ae-js-mcpserver/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "mcp-remote": "0.1.37",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "winccoa-manager": "*"
  },
  "peerDependenciesMeta": {
    "winccoa-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
