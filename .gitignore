# Environment files - never commit, they hold the API token. Patterns are
# unanchored so they match at any depth (mcpWinCCOA/.env, mcpWinCCOA/build/.env),
# and *.env catches the file a mistyped `cp .env.example build\.env` produces in
# bash, where the backslash is an escape and the name collapses to "build.env".
.env
*.env
!.env.example
.claude/settings.local.json

# Root documents copied into the package dir at release time (see release.yml).
# Never commit these duplicates - the originals live at the repo root.
mcpWinCCOA/README.md
mcpWinCCOA/OSS.md
mcpWinCCOA/LEGAL_INFO.md
mcpWinCCOA/LICENSE.md
